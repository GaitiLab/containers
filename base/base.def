Bootstrap: docker
From: ghcr.io/r-lib/rig/ubuntu-22.04-release

%environment
export PATH=/usr/local/bin:$PATH
alias ptp=ptpython
alias r=radian

%post
rig add 4.4.3
rig default 4.4.3

apt-get install -y --no-install-recommends python3 cmake libcurl4-openssl-dev libssl-dev pandoc libcairo2-dev \
libx11-dev libgdal-dev gdal-bin libgeos-dev libproj-dev git xz-utils pari-gp libfftw3-dev \
make libfontconfig1-dev libfreetype6-dev perl libpng-dev libgmp3-dev zlib1g-dev libhdf5-dev \
libnetcdf-dev libglpk-dev libxml2-dev jags libjpeg-dev libsqlite3-dev libmagick++-dev \
gsfonts libzstd-dev poppler-data libpoppler-cpp-dev libtiff-dev libgsl0-dev libbz2-dev \
liblzma-dev default-jdk libicu-dev libfribidi-dev libharfbuzz-dev libudunits2-dev python3-pip pipx
R CMD javareconf
apt-get autoremove -y
apt-get clean

pipx ensurepath
pipx install ptpython 
pipx install radian

%runscript
    exec bash -i
